# Addresses configuration (JSON format)
# Each address specifies which chains (native balance) and/or tokens to monitor
# Optional "service", "pool" and "role" become metric labels for filtering
ADDRESSES_CONFIG='[
  {
    "address": "0x742d35Cc6634C0532925a3b8D8A8E7E1aA9C0e5B",
    "label": "wallet_1",
    "service": "naka-gateway",
    "pool": "ethereum-main",
    "role": "deposit",
    "chains": ["ethereum", "polygon"],
    "tokens": [
      {"chain": "ethereum", "symbol": "USDC"},
      {"chain": "ethereum", "symbol": "USDT"},
      {"chain": "polygon", "symbol": "USDC"}
    ]
  },
  {
    "address": "0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045",
    "label": "wallet_2",
    "chains": ["ethereum", "arbitrum", "optimism"]
  },
  {
    "address": "0xA0b86991c31cC51b673C81C79B0b9B1B2A4e5a8b8",
    "label": "treasury_wallet",
    "chains": ["ethereum"]
  }
]'

# Optional: Prometheus metrics port (default: 8000)
PROMETHEUS_PORT=8000

# Optional: Update interval in seconds (default: 60)
UPDATE_INTERVAL=60

# Optional: Name shown in log lines (default: evm_balance_monitor)
LOGGER_NAME=evm_balance_monitor

# Optional: ERC-20 Transfer log scanning for flow counters
ENABLE_TRANSFER_METRICS=true
TRANSFER_CONFIRMATIONS=5
TRANSFER_MAX_BLOCK_RANGE=1000

# Optional: Centralised exchange accounts (JSON format), grouped by tenant
# Tenant fields are defaults for its accounts; each account can override them.
# Each account carries its own read-only API credentials (Kraken: "Query Funds"; Bitfinex: wallets read).
# Keep your .env out of git: it contains secrets.
EXCHANGES_CONFIG='[
  {
    "tenant": "acme",
    "service": "naka-gateway",
    "pool": "cex",
    "role": "treasury",
    "accounts": [
      {
        "exchange": "kraken",
        "account": "main",
        "label": "Acme Kraken",
        "api_key": "your_kraken_api_key",
        "api_secret": "your_kraken_api_secret",
        "symbols": ["USDT", "BTC", "XAUT"]
      },
      {
        "exchange": "bitfinex",
        "account": "main",
        "label": "Acme Bitfinex",
        "role": "hot",
        "api_key": "your_bitfinex_api_key",
        "api_secret": "your_bitfinex_api_secret",
        "wallet_types": ["exchange", "funding"]
      }
    ]
  },
  {
    "tenant": "globex",
    "service": "naka-gateway",
    "pool": "cex",
    "accounts": [
      {
        "exchange": "kraken",
        "account": "main",
        "label": "Globex Kraken",
        "api_key": "your_globex_kraken_api_key",
        "api_secret": "your_globex_kraken_api_secret"
      }
    ]
  }
]'
